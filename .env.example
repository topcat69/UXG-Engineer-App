# For local dev: run `pnpm db:start`, then `npx supabase status -o env` and
# copy ANON_KEY / SERVICE_ROLE_KEY / API_URL into a .env.local (gitignored).
# These local values are Supabase's well-known local-dev demo keys, not
# secrets — the real ones for a deployed project come from the Supabase
# dashboard and must never be committed.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Phase 4 — Calendar, ICS, email. Public origin the app is reachable at;
# used to build deep links in calendar events/emails and in share-link URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Signs the per-engineer ICS feed URL (HMAC secret — any long random string).
ICS_FEED_SECRET=""

# Google Calendar — one-way OPOC -> Calendar via a service account with
# domain-wide delegation. Optional: calendar sync is best-effort and no-ops
# (never blocks scheduling) when these aren't set.
#   GOOGLE_SERVICE_ACCOUNT_KEY: the full service-account JSON key, as one line.
#   GOOGLE_CALENDAR_IMPERSONATE_EMAIL: in-domain user to impersonate; that
#     service account's client ID must be authorized for the Calendar scope
#     in the Workspace admin console (Security > API Controls > Domain-wide
#     Delegation).
#   GOOGLE_CALENDAR_ID: defaults to "primary" (the impersonated user's own
#     calendar) if unset.
GOOGLE_SERVICE_ACCOUNT_KEY=""
GOOGLE_CALENDAR_IMPERSONATE_EMAIL=""
GOOGLE_CALENDAR_ID=""

# Resend — transactional email. Optional: sending is best-effort and no-ops
# when unset, same as Calendar above.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="OPOC <notifications@opoc.example.com>"

# Shared secret the DB webhook (status_events -> submitted) and cron routes
# must present in an X-Webhook-Secret header — anyone who doesn't know this
# can't trigger these routes. Any long random string.
WEBHOOK_SHARED_SECRET=""

# Monday.com — every issue raised (office or field) is logged as an item on
# an "Issues" board. Optional: best-effort and no-ops when unset, same as
# Calendar/Resend above — an unconfigured integration never blocks an
# engineer raising an issue.
#   MONDAY_API_TOKEN: a personal or account API token from
#     Monday.com > Avatar > Admin > API, needs write access to the board.
#   MONDAY_ISSUES_BOARD_ID: the numeric id of the target board (visible in
#     its URL, e.g. monday.com/boards/<this number>) — the "Issues" board
#     under UX Global's CRM workspace (board 5102058078). The column ids
#     this app writes to (description, severity, status, reported date) are
#     hardcoded in src/lib/monday/issue-payload.ts against that specific
#     board's real columns — pointing this at a board with a different
#     structure will silently write to columns that don't exist.
MONDAY_API_TOKEN=""
MONDAY_ISSUES_BOARD_ID=""
