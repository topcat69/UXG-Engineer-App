# For local dev: run `pnpm db:start`, then `npx supabase status -o env` and
# copy ANON_KEY / SERVICE_ROLE_KEY / API_URL into a .env.local (gitignored).
# These local values are Supabase's well-known local-dev demo keys, not
# secrets — the real ones for a deployed project come from the Supabase
# dashboard and must never be committed.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
